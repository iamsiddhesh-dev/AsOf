# Copy to .env, then fill the two keys. Never commit .env.
#
#   Copy-Item .env.example .env

# ---------------------------------------------------------------------------
# Model — Groq, OpenAI-compatible.
# Groq is the default because its free tier (~30 req/min, ~1,000 req/day) is
# about 20x the OpenRouter free daily cap this project outgrew.
# Keys: https://console.groq.com/keys
#
# Model IDs move. After filling a key:
#   npm run doctor            confirms the key and that the ID is served
#   npm run probe:models      checks JSON, citations, and empty-evidence refusal
# ---------------------------------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# The fast call (routing, reference resolution) can run a smaller model on the
# same key. Leave FAST_BASE_URL and FAST_API_KEY empty to reuse the main
# provider and key; set both to route the two calls to different providers.
#
# Groq also serves openai/gpt-oss-120b, which is larger but sometimes emits
# full-width 【s1】 citations instead of [s1]. Use it once the parser
# normalises those glyphs.
FAST_MODEL=openai/gpt-oss-20b
FAST_BASE_URL=
FAST_API_KEY=

# Alternatives — keep one provider, swap the model lines.
#
# OpenRouter (free `:free` models, 20 req/min and ~50 req/day below 10 USD of
# lifetime credits; probed well on this repo's prompts):
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=particle-ai/particle-1:free
#   FAST_MODEL=particle-ai/particle-1:free
#   key: https://openrouter.ai/keys
#
# Google AI Studio (OpenAI-compatible, about 10 req/min free):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash
#   FAST_MODEL=gemini-2.5-flash-lite
#   key: https://aistudio.google.com/apikey

# ---------------------------------------------------------------------------
# Search — one provider, done well.
# Tavily: 1,000 free credits/month, one search costs one credit.
# Keys: https://app.tavily.com/home
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
DATABASE_PATH=./data/asof.db
DEFAULT_TIMEZONE=Asia/Kolkata

# Demo history is loaded by an explicit request, never on boot.
DEMO_MODE=0

# Freeze the clock for tests and demos. Every "now" flows through this.
# Example: FAKE_NOW=2026-11-15T10:00:00Z
FAKE_NOW=
