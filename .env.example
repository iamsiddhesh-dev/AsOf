# Model: any OpenAI-compatible endpoint. Two calls on the answer path at most.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
FAST_MODEL=

# Search: one provider, done well.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Server
PORT=8787
DATABASE_PATH=./data/asof.db
DEFAULT_TIMEZONE=Asia/Kolkata

# Demo history is loaded by an explicit request, never on boot.
DEMO_MODE=0

# Freeze the clock for tests and demos. Every "now" flows through this.
# Example: FAKE_NOW=2026-11-15T10:00:00Z
FAKE_NOW=
