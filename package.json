{
  "name": "asof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first temporal agent with a claim ledger.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run build:api",
    "build:api": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "build:ui": "npm --prefix web run build",
    "build:all": "npm run build:api && npm run build:ui",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "doctor": "tsx scripts/doctor.ts",
    "eval": "tsx eval/run.ts",
    "probe:models": "tsx scripts/probe-models.ts",
    "smoke:answer": "tsx scripts/smoke-answer.ts",
    "smoke:recheck": "tsx scripts/smoke-recheck.ts",
    "smoke:stream": "tsx scripts/smoke-stream.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "npm --prefix web run typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "better-sqlite3": "^13.2.0",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
